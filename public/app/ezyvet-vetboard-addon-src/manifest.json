{
  "manifest_version": 3,
  "name": "RoomBoard ezyVet Capture",
  "version": "1.0.13",
  "description": "Capture an ezyVet calendar appointment on hover/click and send it into RoomBoard with the Quick Add panel.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://*.ezyvet.com/*",
    "https://*.ezyvet.com/*",
    "http://*/*",
    "https://*/*",
    "file:///*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "RoomBoard ezyVet Capture",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*.ezyvet.com/*",
        "https://*.ezyvet.com/*",
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "scheduler-capture.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
