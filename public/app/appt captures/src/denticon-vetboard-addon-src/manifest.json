{
  "manifest_version": 3,
  "name": "RoomBoard Denticon Capture",
  "version": "0.2.0",
  "description": "Capture visible Denticon schedule appointments and send them into RoomBoard with the Quick Add panel.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.denticon.com/*",
    "https://*.planetdds.com/*",
    "https://bqqjtgbfvtscwhbhscps.supabase.co/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "RoomBoard Denticon Capture",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.denticon.com/*",
        "https://*.planetdds.com/*"
      ],
      "js": [
        "scheduler-capture.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
