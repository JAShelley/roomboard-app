{
  "manifest_version": 3,
  "name": "RoomBoard Pulse Capture",
  "version": "1.0.17",
  "description": "Capture a scheduler appointment on hover/click and send it into VetBoard with the Quick Add panel.",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://*.evetpractice.com/*",
    "https://*.evetpractice.com/*",
    "http://*.covetrus.com/*",
    "https://*.covetrus.com/*",
    "http://*.covetruspulse.com/*",
    "https://*.covetruspulse.com/*",
    "http://*.pulsevet.com/*",
    "https://*.pulsevet.com/*",
    "http://*/*",
    "https://*/*",
    "file:///*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "RoomBoard Pulse Capture",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "scheduler-capture.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
