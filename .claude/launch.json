{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "roomboard-dev",
      "runtimeExecutable": "/Applications/Codex.app/Contents/Resources/cua_node/bin/node",
      "runtimeArgs": ["node_modules/.bin/next", "dev"],
      "port": 3000
    },
    {
      "name": "landing",
      "runtimeExecutable": "/usr/bin/python3",
      "runtimeArgs": ["/tmp/serve-roomboard-landing.py"],
      "port": 4000,
      "autoPort": true
    },
    {
      "name": "app-static",
      "runtimeExecutable": "/usr/bin/python3",
      "runtimeArgs": ["/tmp/serve-roomboard-app.py"],
      "port": 4001,
      "autoPort": true
    },
    {
      "name": "design-system",
      "runtimeExecutable": "/usr/bin/python3",
      "runtimeArgs": ["/tmp/serve-roomboard-design.py"],
      "port": 4002,
      "autoPort": true
    }
  ]
}
