# Copy this file to `.env.local`.
# In Next.js browser-based Supabase auth uses public env vars, so place your
# Supabase project values in the NEXT_PUBLIC_* fields below.
#
# Supabase URL (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
#
# Supabase anon/public key (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (Project Settings -> API)
# Server-only. Use this in your deployed Next.js app so Pulse addon API routes
# can read/write practice data securely on behalf of the logged-in user.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#
# Optional: lock the /api/pulse/* CORS allow-origin to your app's origin so
# arbitrary websites can't script those endpoints from a signed-in browser.
# Native Pulse apps ignore CORS, so this only affects browsers. Leave unset to
# allow "*" (fine for launch; tighten when you have a stable web origin).
PULSE_ALLOWED_ORIGIN=
#
# Reference names from the product brief:
# SUPABASE_URL -> use NEXT_PUBLIC_SUPABASE_URL in this app
# SUPABASE_ANON_KEY -> use NEXT_PUBLIC_SUPABASE_ANON_KEY in this app

# ---------------------------------------------------------------------------
# Billing enforcement kill switch.
# ---------------------------------------------------------------------------
# UNSET or anything other than 1/true/yes/on => billing is NOT enforced: every
# signed-in clinic gets full access, no paywall, no trial countdown. This is the
# deliberate default so a missed env var can never lock a clinic out of its board.
#
# Enforcing billing takes BOTH halves, or the app and the database disagree:
#   1. BILLING_ENFORCED=true here (decides what /api/billing/status reports)
#   2. update public.billing_settings set enforced = true, updated_at = now();
#      (decides whether Postgres RLS lets the board save — 26 policies read it)
# See supabase/billing-enforcement-switch.sql.
BILLING_ENFORCED=

# ---------------------------------------------------------------------------
# Stripe billing (server-only). Create these in the Stripe Dashboard.
# Use TEST-mode keys (sk_test_..., price ids from test products) while building.
# ---------------------------------------------------------------------------
# Secret API key (Developers -> API keys)
STRIPE_SECRET_KEY=sk_test_your-secret-key
# Webhook signing secret (Developers -> Webhooks -> your endpoint -> Signing secret).
# For local testing here: stripe listen --forward-to localhost:3004/api/billing/webhook
# For Vercel, create the endpoint at https://your-domain.com/api/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# Recurring Price IDs — two tiers, each with monthly + annual (Products -> Pricing)
STRIPE_PRICE_BASE_MONTHLY=price_your-base-monthly-price-id
STRIPE_PRICE_BASE_ANNUAL=price_your-base-annual-price-id
STRIPE_PRICE_ADVANCED_MONTHLY=price_your-advanced-monthly-price-id
STRIPE_PRICE_ADVANCED_ANNUAL=price_your-advanced-annual-price-id
# Optional founding-clinic offer. When set, Advanced-monthly checkouts auto-apply
# this coupon until it runs out (cap = the coupon's max_redemptions; "for life" =
# coupon duration "forever"). Leave blank to disable. Coupons -> create coupon.
STRIPE_COUPON_FOUNDING=
# PostHog analytics (posthog.com -> Project Settings -> Project API Key)
NEXT_PUBLIC_POSTHOG_KEY=phc_your-project-api-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
