<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RoomBoard.Capture.Helper</AssemblyName>
    <RootNamespace>RoomBoard.Capture.Helper</RootNamespace>
  </PropertyGroup>
  <!-- UIAutomationClient/UIAutomationTypes come from the WindowsDesktop framework
       via UseWPF; explicit versionless References resolve ambiguously across SDKs
       (MSB3243) and must not be re-added. -->
</Project>
